# Supabase Configuration (Optional - Fallback demo/local storage is active by default)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Groq API Keys (Ultra-fast inference & high RPM - Llama 3.3, Llama 3.1)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Keys for 1-Time AI Coding Assistant (Gemma 4, Gemini 3.5, 3.1)
# Option A: Comma-separated keys (automatically falls back to next key if one is rate-limited)
VITE_GEMINI_API_KEY=primary_key_here,fallback_key_2_here,fallback_key_3_here

# Option B: Numbered keys
# VITE_GEMINI_API_KEY_1=your_first_gemini_key
# VITE_GEMINI_API_KEY_2=your_second_gemini_key
# VITE_GEMINI_API_KEY_3=your_third_gemini_key


